ENV=local
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db.your-project.supabase.co:5432/postgres
DATABASE_URL_MIGRATIONS=postgresql+psycopg2://postgres:postgres@db.your-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated
ALLOW_PUBLIC_SIGNUP=false
# CORS only matters for local dev, where the frontend (Vite dev server) and
# backend run as separate processes on separate ports. In production, the
# backend serves the built frontend itself (same origin), so browsers never
# send a cross-origin request and this setting has no effect either way.
CORS_ORIGINS=http://localhost:5193

# Optional: enables AI-assisted parsing on the Order Email Scan page's
# "Record Order" action (reads order details and line items from the email
# body and any PDF/image attachments using Claude Haiku 4.5). Without this,
# Record Order still works using basic pattern matching instead.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Order Email Scan: connecting a Gmail or Outlook account. OAuth happens
# server-side (not in the browser) specifically so the refresh token can be
# stored encrypted and silently renewed — the user only has to sign in again
# if access actually expires or is revoked, not on every scan.
#
# Required regardless of which provider(s) you configure below: a key to
# encrypt stored refresh tokens at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing/changing this key makes every already-connected account unreadable
# (they'll need reconnecting) — treat it like any other production secret.
TOKEN_ENCRYPTION_KEY=

# Optional: enables connecting Gmail accounts.
# 1. Google Cloud Console > APIs & Services > Credentials > Create OAuth
#    client ID > Application type "Web application".
# 2. Under "Authorized redirect URIs" add:
#      http://localhost:8123/api/v1/email-accounts/gmail/callback   (local dev)
#      https://<your-render-domain>/api/v1/email-accounts/gmail/callback   (production)
# 3. Enable the Gmail API for the project (APIs & Services > Library).
# 4. Under OAuth consent screen, make sure the app requests offline access
#    (this is automatic — no separate setting needed here).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail "folder" (label) a recorded order's email is moved into. Created
# automatically the first time it's needed. Defaults to "Bead Store Orders"
# if unset.
GMAIL_ORDERS_LABEL=Bead Store Orders

# Optional: enables connecting Outlook/Microsoft 365 accounts.
# 1. Azure Portal > Entra ID > App registrations > New registration (or reuse
#    an existing one).
# 2. Under Authentication > Add a platform, add a "Web" platform (NOT
#    "Single-page application" — a client secret is required here) with
#    redirect URI:
#      http://localhost:8123/api/v1/email-accounts/outlook/callback   (local dev)
#      https://<your-render-domain>/api/v1/email-accounts/outlook/callback   (production)
# 3. Under Certificates & secrets, create a new client secret and copy its
#    VALUE (not the secret ID) into MICROSOFT_CLIENT_SECRET below.
# 4. Under API permissions, add Microsoft Graph delegated permissions
#    "Mail.ReadWrite" and "offline_access" (if not already present).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Outlook folder a recorded order's email is moved into. Created
# automatically the first time it's needed. Defaults to "Bead Store Orders"
# if unset.
OUTLOOK_ORDERS_LABEL=Bead Store Orders

# Etsy integration (see docs/design/api-tiers-work-plan.md Phase 3). Not
# needed yet — there's no Etsy shop to connect to. ETSY_SIMULATOR_ENABLED
# turns on a built-in fake Etsy server (mounted at /etsy-simulator) so the
# integration can be exercised without real credentials; ETSY_API_BASE_URL
# then points at it instead of the real Etsy API.
ETSY_SIMULATOR_ENABLED=true
ETSY_API_BASE_URL=http://localhost:8123/etsy-simulator
# Any values work against the simulator — it only checks they're consistent
# with what get_connect_url sends, not that they're real. Once there's a
# real Etsy Developer Portal app: set these to its keystring/shared secret,
# set ETSY_API_BASE_URL=https://openapi.etsy.com/v3, and turn the simulator
# off.
ETSY_CLIENT_ID=dev-etsy-keystring
ETSY_CLIENT_SECRET=dev-etsy-secret
# Verifies the signature on incoming order.paid webhooks (real Etsy signs
# them the same way) — any value works against the simulator, which uses
# this same setting to sign its own test webhook deliveries.
ETSY_WEBHOOK_SIGNING_SECRET=dev-etsy-webhook-secret
