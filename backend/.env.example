ENV=local
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db.your-project.supabase.co:5432/postgres
DATABASE_URL_MIGRATIONS=postgresql+psycopg2://postgres:postgres@db.your-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated
ALLOW_PUBLIC_SIGNUP=false
# CORS only matters for local dev, where the frontend (Vite dev server) and
# backend run as separate processes on separate ports. In production, the
# backend serves the built frontend itself (same origin), so browsers never
# send a cross-origin request and this setting has no effect either way.
CORS_ORIGINS=http://localhost:5173
