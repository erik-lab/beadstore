# Local dev: frontend (Vite dev server) and backend run as separate processes
# on separate ports, so this must be an absolute URL pointing at the backend.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# In production (single combined Render Web Service, backend serving the
# built frontend), use a relative path instead — same origin, no host needed:
# VITE_API_BASE_URL=/api/v1

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: enables the Order Email Scan prototype's Gmail inbox scanning.
# Create an OAuth 2.0 "Web application" client in Google Cloud Console
# (APIs & Services > Credentials), enable the Gmail API, and add this app's
# URL (e.g. http://localhost:5173 and the Render URL) to "Authorized
# JavaScript origins". No client secret needed — the browser-only flow uses
# just the client ID, and tokens are never stored.
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Gmail "folder" (label) a recorded order's email is moved into. Created
# automatically the first time it's needed. Defaults to "Bead Store Orders"
# if unset.
VITE_GMAIL_ORDERS_LABEL=Bead Store Orders

# Optional: enables the Order Email Scan prototype's Outlook/Microsoft 365
# inbox scanning. Register an app in the Azure Portal (Entra ID > App
# registrations > New registration), platform type "Single-page application
# (SPA)", with this app's URL (e.g. http://localhost:5173 and the Render URL)
# as a Redirect URI. Under API permissions, add Microsoft Graph delegated
# permission "Mail.ReadWrite". No client secret needed — the browser-only
# flow uses just the Application (client) ID, and tokens are never stored.
# VITE_MICROSOFT_CLIENT_ID=your-azure-app-client-id

# Outlook folder a recorded order's email is moved into. Created
# automatically the first time it's needed. Defaults to "Bead Store Orders"
# if unset.
VITE_OUTLOOK_ORDERS_LABEL=Bead Store Orders
