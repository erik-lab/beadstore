# Local dev: frontend (Vite dev server) and backend run as separate processes
# on separate ports, so this must be an absolute URL pointing at the backend.
VITE_API_BASE_URL=http://localhost:8123/api/v1

# In production (single combined Render Web Service, backend serving the
# built frontend), use a relative path instead — same origin, no host needed:
# VITE_API_BASE_URL=/api/v1

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Order Email Scan's Gmail/Outlook connections are entirely server-mediated
# now (so credentials can be persisted encrypted and silently renewed instead
# of re-prompting every scan) — see backend/.env.example for the
# GOOGLE_CLIENT_ID / MICROSOFT_CLIENT_ID setup. Nothing to configure here on
# the frontend for it.
